  "question": {
    "status": ["open", "partially-answered", "answered"],
    "horizon": ["now", "next", "later", "parked"]
  },
  "softMaxLines": {
    "system": 120,
    "process": 150,
    "concept": 220,
    "team": 120,
    "project": 160,
    "location": 120,
    "question": 100
  },
